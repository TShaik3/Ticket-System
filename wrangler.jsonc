{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticket-system",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (service key, Stripe, Resend) are set with `wrangler secret put`; see README.
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "Events",
    "NEXT_PUBLIC_SITE_URL": "https://tickets.example.org",
    "NEXT_PUBLIC_TIMEZONE": "America/Los_Angeles"
  }
}
